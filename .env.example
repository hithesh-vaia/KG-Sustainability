# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Neo4j (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Embeddings: "fastembed" (local, no API key, slow) or "gemini" (batched API, fast)
EMBED_PROVIDER=fastembed
EMBED_DIM=384
EMBED_BATCH=100
EMBED_MODEL=BAAI/bge-small-en-v1.5
# required when EMBED_PROVIDER=gemini (EMBED_DIM must then match, e.g. 1536)
# GEMINI_API_KEY=...
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ingestion tuning
CHUNK_TOKENS=2400
CHUNK_OVERLAP=100
REPORTING_ENTITY=          # org that owns the docs; anchors orphan figures
LINK_PERIOD_SIBLINGS=1     # chain each metric across reporting years
MAX_GLEANINGS=1
MAX_CLUSTER_SIZE=10
LLM_CONCURRENCY=1
LLM_MAX_TOKENS=4096      # cap completion length (lower if OpenRouter returns 402)
